{
  "name": "gwp-2026-q2-gift-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "2026 2분기 GWP 선물 공유 대시보드 (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute gwp-2026-q2 --local --file=./migrations/0001_init.sql",
